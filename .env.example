# =============================================================================
# SevakAI — Backend Environment Variables
# Copy to .env and fill in values. The backend is FastAPI (not Django).
# =============================================================================

# --- Email notifications (leave blank during development) ---
# Escalations degrade gracefully to "logged" status when these are unset.
TRIAGEIQ_SMTP_HOST=smtp.yourprovider.com
TRIAGEIQ_SMTP_PORT=587
TRIAGEIQ_SMTP_USER=you@yourprovider.com
TRIAGEIQ_SMTP_PASSWORD=change-me
TRIAGEIQ_SMTP_FROM=noreply@sevakai.com

# --- Caching (memory in dev; redis for multi-worker production) ---
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# --- Error tracking (optional) ---
SENTRY_DSN=

# --- Rate limiting (set to 1 to disable; pytest sets this automatically) ---
RATE_LIMIT_DISABLED=0

# --- Feature flags ---
# Set to "true" to enable the password-reset flow (in-memory tokens, dev only)
SEVAK_AI_ENABLE_PASSWORD_RESET=false
